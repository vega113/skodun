# SYNTHESIZED. A method this server does not implement is -32601, and naming it
# back is deliberate: the client's log is where a version mismatch gets
# diagnosed. The subset skodun serves is fixed (initialize, notifications/
# initialized, ping, tools/list, tools/call, prompts/list, prompts/get);
# resources, sampling, roots and completion are NOT part of it.
> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
< {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": "2025-06-18"}}
> {"jsonrpc":"2.0","id":2,"method":"resources/list"}
< {"jsonrpc": "2.0", "id": 2, "error": {"code": -32601, "message": {"$contains": "resources/list"}}, "result": {"$absent": true}}
> {"jsonrpc":"2.0","id":3,"method":"sampling/createMessage","params":{"messages":[]}}
< {"jsonrpc": "2.0", "id": 3, "error": {"code": -32601}}
> {"jsonrpc":"2.0","id":4,"method":"completion/complete"}
< {"jsonrpc": "2.0", "id": 4, "error": {"code": -32601}}
# `notifications/initialized` is a NOTIFICATION-only method. Sent as a request
# it is not in the request table, so it is -32601 rather than a silent 0-arg
# success that would tell the client its handshake completed twice.
> {"jsonrpc":"2.0","id":5,"method":"notifications/initialized"}
< {"jsonrpc": "2.0", "id": 5, "error": {"code": -32601}}
# The same unknown methods WITHOUT an id are notifications: ignored in silence,
# no matter how alarming the name.
> {"jsonrpc":"2.0","method":"resources/list"}
> {"jsonrpc":"2.0","method":"notifications/cancelled","params":{"requestId":1}}
> {"jsonrpc":"2.0","method":"notifications/roots/list_changed"}
> {"jsonrpc":"2.0","method":"nonsense"}
# Still serving, and the four notifications above produced nothing.
> {"jsonrpc":"2.0","id":6,"method":"ping"}
< {"jsonrpc": "2.0", "id": 6, "result": {"$keys": []}}
